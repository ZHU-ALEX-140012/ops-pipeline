# ops-pipeline 的环境变量示例
#
# 用法（PowerShell，仅当前会话）：
#   $env:OPS_WECOM_WEBHOOK = "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx"
#
# 永久生效（用户级）：
#   [Environment]::SetEnvironmentVariable("OPS_WECOM_WEBHOOK", "...", "User")
#
# ⚠️ 千万不要把这些值写进 config.toml 或提交到 git。
#    配置里只写"环境变量名"，值只存在于环境里。
#
# 方式二（推荐给计划任务用）：把它们写进 config/secrets.local.toml，键名同上。
#    该文件已在 .gitignore 中。为什么推荐文件：**计划任务不一定能及时看到新设的
#    环境变量**（Task Scheduler 的环境块可能被缓存，改完要重新登录才生效）。
#    最省事的做法是运行 scripts\set-webhook.cmd，它会帮你写好并立刻发一条测试消息。
#
# 企业微信群机器人怎么拿：
#   企业微信 → 任意群 → 右上角 … → 群机器人 → 添加机器人 → 复制 Webhook 地址
#   个人也可以注册企业微信并建一个只有自己的群，用来收自己的告警。

# 主通道：企业微信群机器人（需要普通内部群；全员群 / 单人企业拿不到入口）
OPS_WECOM_WEBHOOK=

# 主通道（推荐）：企业微信自建应用 —— 单人企业也能用，没有群类型限制
#   CorpID  管理后台 → 我的企业 → 企业信息 → 最下方「企业ID」
#   Secret / AgentId  管理后台 → 应用管理 → 自建 → 创建应用 → 应用详情页
#   ⚠️ 记得把应用的「可见范围」设成包含你自己，否则会返回 invaliduser
OPS_WECOM_CORPID=
OPS_WECOM_SECRET=
OPS_WECOM_AGENTID=

# 备通道：邮件（可选，config/config.toml 里 alert.email.enabled = true 才生效）
OPS_MAIL_USER=
OPS_MAIL_PASS=
OPS_MAIL_TO=
