# 构建上下文瘦身 + 隐私隔离（与 .gitignore 同思路：机密与运行数据绝不进镜像）
.git
.github
.pytest_cache
.ruff_cache
.venv
venv
__pycache__
*.py[cod]
*.egg-info

# 测试与评测不进镜像（CI 直接在 checkout 上跑，不用镜像）
tests
evals
assets

# 运行数据：数据库 / 报告 / 留痕 / 日志
data

# 凭据与本地覆盖：绝不进镜像
.env
config/config.local.toml
config/secrets.local.toml

# 机器专属启动器（含本机绝对路径）
scripts
*.cmd
*.ps1

# 本机杂项
B站爬虫数据
tools/_*.py
